{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcoa/job.schema.json",
  "title": "Job file written by the app, protocol version 1",
  "description": "Every path the worker touches comes from here; the worker has no other source of paths.",
  "type": "object",
  "required": ["protocol_version", "job_id", "kind", "project_dir", "log_path", "resources_dir", "payload"],
  "properties": {
    "protocol_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^j_[0-9A-Za-z_-]+$"},
    "kind": {"enum": ["index", "convert", "segment", "metrics", "viewer_cache", "export", "selftest", "spike_s2"]},
    "project_dir": {"type": "string"},
    "log_path": {"type": "string"},
    "resources_dir": {"type": "string", "description": "The app bundle's Contents/Resources; models and manifest are found here."},
    "heartbeat_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 10},
    "payload": {"type": "object"}
  }
}
