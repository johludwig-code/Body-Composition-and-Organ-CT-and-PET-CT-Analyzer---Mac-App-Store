{
  "description": "Patient links (ADR 0024), computed with Python's hmac. The worker (pytest) and the app's LinkHasher (swift test) must both reproduce every value. All IDs and folder names are synthetic.",
  "rules": {
    "link_key": "\"base64:\" + standard base64 (with padding) of the 32 key bytes; the HMAC key is the decoded bytes",
    "link_key_id": "the first 16 hex characters of HMAC-SHA256(key, UTF-8 \"bcoa.link-key-id\")",
    "patient_id": "strip spaces and NUL from both ends, then NFC; empty is missing; a case-folded match in placeholder_ids is a placeholder; neither has a link",
    "pid": "\"pid:\" + hex HMAC-SHA256(key, UTF-8 of \"pid\" U+001F id)",
    "folder": "\"folder:\" + hex HMAC-SHA256(key, UTF-8 of \"folder\", source_id in decimal and components 1 to level, each NFC, joined by U+001F); level 0 is the source folder itself"
  },
  "placeholder_ids": [
    "ANONYMOUS", "ANONYMIZED", "ANONYMISED", "ANON", "UNKNOWN", "NONE", "NULL", "N/A", "NA", "0",
    "-"
  ],
